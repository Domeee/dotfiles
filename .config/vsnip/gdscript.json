{
  "log": {
    "prefix": [
      "log"
    ],
    "body": "Logger.debug($1)"
  },
  "ignore warning untyped declaration": {
    "prefix": [
      "warnuntyped"
    ],
    "body": "@warning_ignore(\"untyped_declaration\")"
  },
  "ignore warning unsafe call argument": {
    "prefix": [
      "warnunsafecallargument"
    ],
    "body": "@warning_ignore(\"unsafe_call_argument\")"
  },
  "ignore warning unsafe method access": {
    "prefix": [
      "warnunsafemethodaccess"
    ],
    "body": "@warning_ignore(\"unsafe_method_access\")"
  },
  "ignore warning property access": {
    "prefix": [
      "warnunsafepropertyaccess"
    ],
    "body": "@warning_ignore(\"unsafe_property_access\")"
  }
}
